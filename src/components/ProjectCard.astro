---
import type { Post } from '../lib/posts';
import { dateParts } from '../lib/posts';
import TagList from './TagList.astro';
interface Props { post: Post }
const { post } = Astro.props;
const date = dateParts(post.frontmatter.pubDate);
---
<article class="project-card" data-entry-date={date.full} data-entry-id={post.url}>
  <a class="project-cover" href={post.url} aria-label={`查看作品：${post.frontmatter.title}`}>
    <span class="project-cover-placeholder" aria-hidden="true"><span>作品集</span><strong>{post.frontmatter.title}</strong><span>每一个想法，都慢慢成形。 ↗</span></span>
    {post.cover && <img src={post.cover} alt={post.frontmatter.coverAlt || post.frontmatter.title} loading="lazy" decoding="async" width="800" height="500" data-project-cover />}
  </a>
  <div class="project-info">
    <time datetime={date.full}>{date.full}</time>
    <h2><a href={post.url}>{post.frontmatter.title} <span aria-hidden="true">↗</span></a></h2>
    {post.frontmatter.description && <p>{post.frontmatter.description}</p>}
    <TagList tags={post.tags} />
  </div>
</article>
<script>
  for (const image of document.querySelectorAll<HTMLImageElement>('[data-project-cover]')) {
    const fallback = () => { image.hidden = true; };
    image.addEventListener('error', fallback, { once: true });
    if (image.complete && image.naturalWidth === 0) fallback();
  }
</script>
<style is:global>
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 28px; }
  .project-card { min-width: 0; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: #c7b5f203; }
  .project-card:hover { border-color: #c7b5f24d; }
  .project-cover { display: block; position: relative; aspect-ratio: 8 / 5; overflow: hidden; background: radial-gradient(ellipse at 80% 10%, #69567e55, transparent 65%), #1a1923; }
  .project-cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .project-cover img[hidden] { display: none; }
  .project-cover-placeholder { height: 100%; padding: clamp(20px, 4vw, 40px); display: flex; flex-direction: column; justify-content: space-between; color: var(--muted); gap: 18px; }
  .project-cover-placeholder > span { font-size: 11px; letter-spacing: .12em; }
  .project-cover-placeholder strong { font: 400 clamp(20px, 3vw, 30px)/1.5 var(--serif); color: #d9d0e6; overflow-wrap: anywhere; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .project-info { padding: 22px 25px 26px; }
  .project-info time { color: var(--dim); font-size: 11px; }
  .project-info h2 { margin-top: 9px; font: 400 23px/1.6 var(--serif); overflow-wrap: anywhere; }
  .project-info h2 a:hover { color: var(--accent); }
  .project-info h2 span { color: var(--accent); font: 15px var(--sans); }
  .project-info > p { margin-top: 10px; color: var(--muted); font-size: 12px; line-height: 1.9; }
  .portfolio-showcase { padding-block: 26px 42px; }
  @media (max-width: 640px) { .project-grid { grid-template-columns: 1fr; gap: 18px; } .project-info { padding: 20px; } }
</style>
