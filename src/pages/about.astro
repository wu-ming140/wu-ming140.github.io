---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site, about } from '../site';
---
<SiteLayout title="关于" active="about" description={`关于${site.name}。`}>
  <article class="article-container">
    <header class="article-header">
      <p class="about-label">关于这个小小的地方</p>
      <h1>你好，这里是{site.shortName}。</h1>
      <p class="article-description">{site.name} · {site.description}</p>
    </header>
    <div class="prose about-body">
      <p>欢迎来到这个小站。</p>
      <p>{about.intro}</p>
      {about.sections.map((section) => <><h2>{section.title}</h2><p>{section.text}</p></>)}
      <blockquote><p>{about.thanks}</p></blockquote>
    </div>
  </article>
</SiteLayout>
