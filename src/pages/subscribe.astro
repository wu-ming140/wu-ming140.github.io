---
import SiteLayout from '../layouts/SiteLayout.astro';
import { localPath } from '../site';
const feeds = [
  { title: '全站动态', path: 'rss.xml', description: '文章、作品、留言与提问，都收在这一份。' },
  { title: '文章与作品', path: 'posts/rss.xml', description: '只订阅大厅五个专栏里的新内容。' },
  { title: '留言与问答', path: 'guestbook/rss.xml', description: '看看新的来信、其他渠道提问和随附的公开回复。' },
];
---
<SiteLayout title="RSS 订阅" description="用你喜欢的 RSS 阅读器，订阅小站的公开更新。">
  <header class="page-header container"><p class="eyebrow">把更新带回去</p><h1>订阅小站。</h1><p>复制下面的订阅地址，添加到你喜欢的 RSS 阅读器。每份订阅保留最近 50 项公开内容。</p></header>
  <section class="archive container" aria-label="订阅源">
    {feeds.map((feed) => <article class="feed-card"><h2>{feed.title}</h2><p>{feed.description}</p><a href={localPath(feed.path)}>{new URL(localPath(feed.path), Astro.site).href}</a><button type="button" data-feed-url={new URL(localPath(feed.path), Astro.site).href}>复制订阅地址</button></article>)}
    <p class="feed-status" role="status" id="feed-status"></p>
    <p class="feed-hint">订阅不需要登录。阅读器的更新频率由你使用的阅读器决定；旧来信新增回复是否提醒，也取决于阅读器。</p>
  </section>
</SiteLayout>
<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-feed-url]')) button.addEventListener('click', async () => {
    const status = document.getElementById('feed-status')!;
    try { await navigator.clipboard.writeText(button.dataset.feedUrl!); status.textContent = '订阅地址已复制，可以粘贴到 RSS 阅读器。'; }
    catch { status.textContent = '暂时无法自动复制，可以长按或选中上面的订阅地址复制。'; }
  });
</script>
<style>
  .feed-card { padding: 26px 0; border-bottom: 1px solid var(--line); }
  .feed-card h2 { font: 400 26px/1.7 var(--serif); }
  .feed-card p { margin: 10px 0 16px; color: var(--muted); font-size: 13px; }
  .feed-card a { display: inline-block; color: var(--accent); font-size: 12px; overflow-wrap: anywhere; margin-right: 20px; }
  .feed-card button { padding: 8px 14px; color: var(--text); background: transparent; border: 1px solid var(--line); border-radius: 4px; cursor: pointer; font-size: 12px; }
  .feed-status { margin-top: 24px; color: var(--accent); font-size: 12px; }
  .feed-hint { margin-top: 20px; color: var(--dim); font-size: 12px; }
</style>
