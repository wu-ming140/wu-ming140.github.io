---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localPath } from '../../site';
import { getGuestbook } from '../../lib/guestbook';
import MessageCard from '../../components/MessageCard.astro';
import CuratedSection from '../../components/CuratedSection.astro';
import BrowseList from '../../components/BrowseList.astro';
import { getCatalog } from '../../lib/catalog';
import '../../styles/guestbook.css';

const messages = await getGuestbook();
const catalog = await getCatalog();
const questions = messages.filter((message) => message.data.kind === 'question');
const filters = [
  { key: 'all', label: '全部', count: messages.length },
  { key: 'message', label: '留言', count: messages.length - questions.length },
  { key: 'question', label: '提问', count: questions.length },
  { key: 'unanswered', label: '待回答', count: questions.filter((message) => !message.replies.length).length },
  { key: 'other', label: '其他渠道', count: messages.filter((message) => message.data.channel === 'other').length },
];
---
<SiteLayout title="留言与问答" active="guestbook" description="留一句话，或问一个问题。这里收下每一份经过的心意。">
  <header class="page-header container guestbook-header">
    <span class="eyebrow">来信与回声</span>
    <h1>留一点声音在这里。</h1>
    <p>打个招呼，分享近况，或者问一个问题。<br />我会把来信收好，也在这里慢慢回复。</p>
    <div class="guestbook-actions">
      <a class="quiet-link" href={localPath('guestbook/contribute/')}>写留言 / 提问 <span class="arrow" aria-hidden="true">↗</span></a>
      <a class="quiet-link" href={localPath('guestbook/elsewhere/')}>其他渠道来信 <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <p class="guestbook-hint">可以通过 GitHub 留言；从其他地方收到的来信，也会由我整理在这里。</p>
  </header>
  <section class="archive container" aria-label="留言与问答">
    <div class="guestbook-toolbar">
      <div class="guestbook-filters" role="group" aria-label="筛选留言" hidden>
        {filters.map((filter) => <button type="button" data-filter={filter.key} aria-pressed={filter.key === 'all' ? 'true' : 'false'}>{filter.label}<span>{filter.count}</span></button>)}
      </div>
      <p class="guestbook-count" aria-live="polite">共 {messages.length} 条来信</p>
    </div>
    {['guestbook', 'messages', 'questions', 'unanswered', 'elsewhere'].map((board) => <CuratedSection entries={catalog} board={board} hidden={board !== 'guestbook'} />)}
    <div class="guestbook-list">
      <BrowseList>{messages.map((message) => <MessageCard message={message} />)}</BrowseList>
    </div>
    {messages.length === 0 && <div class="guestbook-empty"><span aria-hidden="true">✳</span><h2>第一封来信，还在路上。</h2><p>有什么想说的，就从一句「你好」开始。</p><a class="quiet-link" href={localPath('guestbook/contribute/')}>留下第一句话 <span class="arrow" aria-hidden="true">→</span></a></div>}
    <p class="empty-state" id="filter-empty" hidden>这个分类还没有来信。试试其他分类吧。</p>
    <noscript><p class="guestbook-hint">以下展示全部留言与提问。</p></noscript>
  </section>
<script>
  const group = document.querySelector<HTMLElement>('.guestbook-filters');
  if (group) {
    group.hidden = false;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.message-card'));
    group.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-filter]');
      if (!button) return;
      const filter = button.dataset.filter;
      const board = ({ all: 'guestbook', message: 'messages', question: 'questions', unanswered: 'unanswered', other: 'elsewhere' } as Record<string, string>)[filter!];
      document.querySelectorAll<HTMLElement>('[data-curated-board]').forEach((section) => { section.hidden = section.dataset.curatedBoard !== board; });
      group.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      let count = 0;
      cards.forEach((card) => {
        const visible = filter === 'all' || card.dataset.kind === filter
          || (filter === 'other' && card.dataset.channel === 'other')
          || (filter === 'unanswered' && card.dataset.kind === 'question' && card.dataset.answered === 'false');
        card.hidden = !visible;
        if (visible) count++;
      });
      document.querySelector('.guestbook-count')!.textContent = `显示 ${count} 条来信`;
      document.querySelector<HTMLElement>('#filter-empty')!.hidden = count !== 0 || cards.length === 0;
      document.querySelector('[data-browse-list]')?.dispatchEvent(new Event('browse:filter'));
    });
  }
</script>
</SiteLayout>
