---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PostRow from '../../../components/PostRow.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import BrowseList from '../../../components/BrowseList.astro';
import CuratedSection from '../../../components/CuratedSection.astro';
import { getCatalog } from '../../../lib/catalog';
import { postColumns, columnPath } from '../../../lib/columns';
import { posts } from '../../../lib/posts';
import { localPath } from '../../../site';
import '../../../styles/hall.css';

export function getStaticPaths() {
  return postColumns.map((column) => ({ params: { column: column.slug }, props: { column } }));
}
const { column } = Astro.props;
const columnPosts = posts.filter((post) => post.column.slug === column.slug);
const catalog = await getCatalog();
---
<SiteLayout title={column.title} active="home" description={column.description}>
  <header class="page-header container column-header">
    <a class="back-link" href={localPath('#columns')}>← 返回大厅</a>
    <p class="eyebrow">大厅里的一个角落</p>
    <h1>{column.title}</h1>
    <p>{column.description}</p>
  </header>
  <section class="archive container" aria-label={column.title}>
    <nav class="column-navigation" aria-label="大厅专栏">
      <a href={localPath('#journal')}>全部内容</a>
      {postColumns.map((item) => <a href={localPath(columnPath(item))} aria-current={item.slug === column.slug ? 'page' : undefined}>{item.title}</a>)}
    </nav>
    <CuratedSection entries={catalog} board={column.slug} />
    <div class="section-head"><h2 class="section-title">这个角落里的记录</h2><span class="archive-count">共 {columnPosts.length} 篇</span></div>
    <BrowseList layout={column.slug === 'portfolio' ? 'projects' : 'rows'}>{column.slug === 'portfolio' ? columnPosts.map((post) => <ProjectCard post={post} />) : columnPosts.map((post) => <PostRow post={post} />)}</BrowseList>
    {columnPosts.length === 0 && <div class="column-empty"><span aria-hidden="true">✳</span><h2>这里先留一点空白。</h2><p>属于「{column.title}」的第一份记录，还在慢慢酝酿。</p><a class="quiet-link" href={localPath('#columns')}>去大厅其他地方看看 <span class="arrow" aria-hidden="true">→</span></a></div>}
  </section>
</SiteLayout>
