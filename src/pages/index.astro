---
// 两条 --- 之间是 Astro 的准备区：导入布局、站点文字和文章列表。
import SiteLayout from '../layouts/SiteLayout.astro';
import { site, localPath } from '../site';
import { posts, dateParts } from '../lib/posts';
const latestPosts = posts.slice(0, 5);
---
<!-- 下面是网页结构。SiteLayout 统一提供导航、页脚和样式。 -->
<SiteLayout active="home">
  <section class="hero container" aria-labelledby="home-title">
    <div class="hero-orbit" aria-hidden="true"></div>
    <p class="eyebrow">{site.name}</p>
    <h1 id="home-title">
      <span>{site.headline[0]}</span>
      <span class="second-line">{site.headline[1]}</span>
    </h1>
    <p class="hero-description">{site.intro}</p>
    <div class="hero-bottom">
      <a class="quiet-link" href="#journal">读几篇文字 <span class="arrow" aria-hidden="true">↗</span></a>
      <span class="hero-note">生活 · 文字 · 一点点喜欢</span>
    </div>
  </section>
  <!-- posts 来自 Markdown 文件；新增文章后，这里会自动生成新的列表行。 -->
  <section class="home-journal container" id="journal" aria-labelledby="journal-title">
    <div class="section-head">
      <h2 class="section-title" id="journal-title">最近写下的</h2>
      <span class="section-caption">一些片段，也是一些日常。</span>
    </div>
    {latestPosts.length === 0 && <p class="empty-state">这里正在等待第一篇文字。</p>}
    {latestPosts.map((post) => {
      const date = dateParts(post.frontmatter.pubDate);
      return (
        <a class="post-row" href={post.url}>
          <span class="post-year">{date.year}</span>
          <div>
            <h2>{post.frontmatter.title}</h2>
            <p class="post-row-description">{post.frontmatter.description}</p>
          </div>
          <div class="post-meta">
            <span class="row-category">{post.frontmatter.category || '随笔'}</span>
            <time class="post-date" datetime={date.full}>{date.day}</time>
            <span class="row-arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      );
    })}
    <div class="journal-more"><a class="quiet-link" href={localPath('posts/')}>全部文章 <span class="arrow" aria-hidden="true">→</span></a></div>
  </section>
  <section class="home-quote container" aria-label="小站寄语">
    <p>不必每一天都闪闪发光，<br />有一些值得记住的瞬间，就很好。</p>
    <span>在这里，慢一点也没关系。</span>
    <div class="journal-more"><a class="quiet-link" href={localPath('guestbook/')}>留一点声音在这里 <span class="arrow" aria-hidden="true">↗</span></a></div>
  </section>
</SiteLayout>
