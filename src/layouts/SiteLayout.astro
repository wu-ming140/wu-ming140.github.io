---
import { site, localPath } from '../site';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'guestbook' | 'about';
}

const { title, description = site.description, active = 'home' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const navigation = [
  { key: 'home', label: '大厅', path: '' },
  { key: 'guestbook', label: '留言', path: 'guestbook/' },
  { key: 'about', label: '关于', path: 'about/' },
];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d10" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <link rel="icon" href={localPath('ming-favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="atmosphere" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href={localPath()} aria-label={`${site.name}首页`}>
        <span class="brand-mark" aria-hidden="true">暝</span>
        <span class="brand-text"><strong>{site.shortName}</strong><span>{site.subtitle}</span></span>
      </a>
      <nav aria-label="主导航">
        {navigation.map((item) => (
          <a href={localPath(item.path)} class:list={['nav-link', { current: item.key === active }]}
            aria-current={item.key === active ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-top">
        <a class="footer-name" href={localPath()}>{site.name}</a>
        <p>文字有归处，日子有回声。</p>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} {site.shortName}</span>
        <span>认真生活，慢慢记录。</span>
        <a href="#main">回到顶部 <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0c0d10;
    --surface: #13141a;
    --text: #ebe9e4;
    --muted: #9999a3;
    --dim: #6f707b;
    --line: rgba(255,255,255,.1);
    --accent: #c7b5f2;
    --serif: 'Songti SC', 'Noto Serif SC', 'Source Han Serif SC', 'STSong', 'SimSun', serif;
    --sans: 'Inter', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    font-synthesis: none;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 110px; }
  body { margin: 0; min-width: 320px; line-height: 1.7; -webkit-font-smoothing: antialiased; }
  ::selection { background: #c7b5f2; color: #15111d; }
  a { color: inherit; text-decoration: none; }
  a, button { -webkit-tap-highlight-color: transparent; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  button { font: inherit; }
  h1, h2, h3, p { margin: 0; }
  .container { width: min(1120px, calc(100% - 112px)); margin-inline: auto; }
  .skip-link { position: fixed; left: 20px; top: -80px; z-index: 100; padding: 10px 18px; background: var(--text); color: var(--bg); }
  .skip-link:focus { top: 16px; }
  .atmosphere { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(ellipse at 82% 18%, #4534551d, transparent 46%), radial-gradient(ellipse at 12% 83%, #282b421b, transparent 45%); }
  .site-header { min-height: 100px; width: 100%; padding: 24px 56px; display: flex; align-items: center; justify-content: space-between; gap: 20px; position: relative; z-index: 5; }
  .brand { display: inline-flex; align-items: center; gap: 13px; }
  .brand-mark { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid #b2a3c260; color: #d7c9e8; border-radius: 50%; font-family: var(--serif); font-size: 17px; }
  .brand-text { display: flex; flex-direction: column; }
  .brand-text strong { font-family: var(--serif); letter-spacing: .2em; font-size: 17px; font-weight: 500; line-height: 1.5; }
  .brand-text > span { color: var(--dim); font-size: 10px; letter-spacing: .18em; }
  nav { display: flex; gap: 32px; }
  .nav-link { position: relative; padding: 8px 0; font-size: 13px; color: var(--muted); transition: color .2s; }
  .nav-link:hover, .nav-link.current { color: var(--text); }
  .nav-link.current::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 3px; height: 3px; border-radius: 50%; background: var(--accent); }
  .eyebrow { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 11px; letter-spacing: .19em; text-transform: uppercase; }
  .eyebrow::before { content: ''; width: 24px; height: 1px; background: #c7b5f280; }
  .hero { min-height: min(720px, calc(100svh - 100px)); padding-block: 100px 64px; display: flex; flex-direction: column; justify-content: center; position: relative; }
  .hero .eyebrow { margin-bottom: 38px; }
  .hero h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(40px, 5.8vw, 80px); line-height: 1.5; letter-spacing: .045em; position: relative; z-index: 1; }
  .hero h1 span { display: block; }
  .hero h1 .second-line { color: #c8c0d5; }
  .hero-description { margin-top: 27px; color: var(--muted); font-size: 14px; letter-spacing: .07em; max-width: 520px; line-height: 2; }
  .hero-bottom { margin-top: 66px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .quiet-link { display: inline-flex; align-items: center; gap: 28px; padding-bottom: 6px; border-bottom: 1px solid #d8ccec50; font-size: 13px; }
  .quiet-link .arrow { color: var(--accent); transition: transform .2s; }
  .quiet-link:hover .arrow { transform: translateX(5px); }
  .hero-note { color: var(--dim); font-size: 10px; letter-spacing: .2em; }
  .hero-orbit { position: absolute; right: 12px; top: 70px; width: 280px; height: 280px; border: 1px solid #ad98d414; border-radius: 50%; pointer-events: none; }
  .hero-orbit::before { content: ''; position: absolute; inset: 28px; border: 1px solid #ad98d40b; border-radius: 50%; }
  .hero-orbit::after { content: ''; position: absolute; width: 5px; height: 5px; border-radius: 50%; background: #b49bcc90; top: 66px; right: 22px; box-shadow: 0 0 18px #b49bcc50; }
  .home-journal { padding-block: 65px 105px; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .section-title { font-size: 12px; font-weight: 400; letter-spacing: .18em; color: var(--muted); }
  .section-caption { color: var(--dim); font-size: 11px; letter-spacing: .07em; }
  .post-row { display: grid; grid-template-columns: 72px 1fr auto; gap: 18px; align-items: center; padding: 28px 8px; border-bottom: 1px solid var(--line); transition: background .2s; }
  .post-row:hover { background: #c7b5f205; }
  .post-year { font-size: 12px; font-variant-numeric: tabular-nums; color: var(--dim); }
  .post-row h2 { font-family: var(--serif); font-size: 23px; font-weight: 400; line-height: 1.6; transition: color .2s; }
  .post-row:hover h2 { color: var(--accent); }
  .post-row-description { margin-top: 7px; color: var(--muted); font-size: 12px; line-height: 1.9; }
  .post-meta { display: flex; align-items: center; gap: 22px; color: var(--dim); font-size: 11px; white-space: nowrap; }
  .post-date { font-variant-numeric: tabular-nums; }
  .row-arrow { font-size: 18px; color: var(--muted); }
  .journal-more { display: flex; justify-content: flex-end; margin-top: 30px; }
  .home-quote { border-top: 1px solid var(--line); padding-block: 68px 82px; }
  .home-quote p { font-family: var(--serif); font-size: clamp(20px, 2.4vw, 30px); line-height: 1.9; color: #beb8c6; }
  .home-quote span { display: block; margin-top: 20px; font-size: 11px; color: var(--dim); letter-spacing: .15em; }
  .site-footer { border-top: 1px solid var(--line); padding-block: 38px 25px; }
  .footer-top { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; }
  .footer-name { font-family: var(--serif); font-size: 18px; letter-spacing: .04em; }
  .footer-top p { color: var(--dim); font-size: 12px; }
  .footer-bottom { margin-top: 42px; display: flex; gap: 24px; color: var(--dim); font-size: 10px; letter-spacing: .04em; flex-wrap: wrap; }
  .footer-bottom > a { margin-left: auto; }
  .footer-bottom a:hover { color: var(--text); }
  .page-header { padding-block: 83px 55px; }
  .page-header h1 { font-family: var(--serif); font-size: clamp(38px, 5vw, 58px); font-weight: 400; line-height: 1.5; margin-top: 25px; }
  .page-header p { margin-top: 20px; color: var(--muted); font-size: 14px; line-height: 2; }
  .archive { min-height: 55vh; padding-bottom: 110px; }
  .archive-count { color: var(--dim); font-size: 12px; }
  .article-container { width: min(740px, calc(100% - 112px)); margin-inline: auto; padding-block: 50px 100px; }
  .back-link { color: var(--muted); font-size: 12px; display: inline-block; padding-block: 8px; }
  .back-link:hover { color: var(--accent); }
  .article-header { padding-block: 46px 35px; border-bottom: 1px solid var(--line); margin-bottom: 40px; }
  .article-header h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 4vw, 45px); line-height: 1.6; overflow-wrap: anywhere; }
  .article-metadata { margin-top: 22px; color: var(--dim); font-size: 12px; display: flex; gap: 20px; flex-wrap: wrap; }
  .article-description { margin-top: 25px; color: var(--muted); font-size: 14px; line-height: 2; }
  .sample-note { padding: 12px 16px; border-left: 2px solid #c7b5f250; margin-bottom: 35px; color: var(--muted); font-size: 12px; background: #c7b5f206; }
  .prose { color: #c8c8cf; font-size: 16px; line-height: 2; overflow-wrap: anywhere; }
  .prose > :first-child { margin-top: 0; }
  .prose p { margin: 0 0 1.5em; }
  .prose h2, .prose h3 { color: var(--text); font-family: var(--serif); font-weight: 400; line-height: 1.7; }
  .prose h2 { font-size: 26px; margin: 2em 0 .8em; }
  .prose h3 { font-size: 21px; margin: 1.7em 0 .7em; }
  .prose ul, .prose ol { padding-left: 1.6em; margin-bottom: 1.5em; }
  .prose li { margin-bottom: .4em; }
  .prose strong { color: var(--text); font-weight: 600; }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .prose blockquote { margin: 2em 0; padding: 4px 0 4px 22px; border-left: 2px solid #c7b5f280; color: var(--muted); }
  .prose blockquote p { margin: 0; }
  .prose img { display: block; max-width: 100%; height: auto; margin-block: 1.8em; border-radius: 3px; }
  .prose pre { overflow-x: auto; padding: 20px; border: 1px solid var(--line); border-radius: 5px; font-size: 13px; line-height: 1.8; margin-bottom: 1.8em; }
  .prose :not(pre) > code { padding: 3px 6px; background: #ffffff09; border-radius: 3px; font-size: .88em; color: #d0bddf; }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin-block: 2.5em; }
  .prose table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 1.5em; font-size: 14px; }
  .prose td, .prose th { padding: 10px 16px; border: 1px solid var(--line); text-align: left; }
  .article-end { margin-top: 65px; padding-top: 25px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 20px; color: var(--dim); font-size: 12px; }
  .about-body { padding-bottom: 40px; }
  .about-label { color: var(--accent); font-size: 12px; letter-spacing: .15em; margin-bottom: 30px; }
  .empty-state { padding-block: 45px; color: var(--muted); font-size: 14px; }
  @media (max-width: 760px) {
    .container { width: calc(100% - 44px); }
    .site-header { min-height: 86px; padding: 20px 22px; flex-wrap: wrap; }
    .brand { gap: 9px; }
    .brand-mark { width: 31px; height: 31px; font-size: 15px; }
    .brand-text strong { font-size: 16px; }
    nav { gap: 18px; }
    .nav-link { font-size: 12px; }
    .hero { min-height: 580px; padding-block: 68px 55px; }
    .hero h1 { font-size: clamp(30px, 6.9vw, 48px); letter-spacing: .01em; }
    .hero-description { font-size: 13px; max-width: 290px; }
    .hero-bottom { margin-top: 47px; }
    .hero-note { font-size: 8px; letter-spacing: .13em; }
    .hero-orbit { width: 190px; height: 190px; right: 5px; top: 25px; }
    .home-journal { padding-block: 35px 70px; }
    .section-head { gap: 15px; padding-bottom: 22px; }
    .section-caption { font-size: 10px; }
    .post-row { grid-template-columns: 1fr auto; gap: 10px 16px; padding: 25px 0; }
    .post-year { display: none; }
    .post-row h2 { font-size: 20px; }
    .post-meta { gap: 14px; }
    .post-meta .row-category { display: none; }
    .row-arrow { font-size: 16px; }
    .post-row-description { max-width: 230px; }
    .home-quote { padding-block: 45px 60px; }
    .footer-top { flex-direction: column; gap: 12px; }
    .footer-name { font-size: 17px; }
    .footer-bottom { gap: 12px 18px; margin-top: 30px; font-size: 10px; }
    .footer-bottom > span:nth-child(2) { display: none; }
    .page-header { padding-block: 55px 40px; }
    .article-container { width: calc(100% - 44px); padding-block: 24px 70px; }
    .article-header { padding-block: 32px 28px; }
    .prose { font-size: 15px; }
    .prose h2 { font-size: 23px; }
    .article-end { align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
